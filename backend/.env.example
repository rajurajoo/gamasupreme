# Postgres connection string (Railway provides this automatically when you link the Postgres plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/gama_supreme

# Secret used to sign JWT auth tokens - set this to a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Port the backend server listens on (Railway sets this automatically; only needed for local dev)
PORT=4000

# Origin allowed to call this API in production (your Netlify URL), e.g. https://gama-supreme.netlify.app
ALLOWED_ORIGIN=http://localhost:5173
